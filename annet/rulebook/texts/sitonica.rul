# Operators:
#   *  One argument in undo
#   ~  One or more arguments in undo
#
# Parameters:
#   %global         The command applies at any level below
#   %logic=...      Custom rule processing function
#   %diff_logic=... Custom diff building function.
#                   Works for sub-blocks, unlike %logic
#   %comment=...    Adds a comment after the row; shown with the patch --add-comments option
#                   Primarily used to generate special provisioning commands
# -----

lldp ~
ntp ~
interface
    mtu
bgp
    bmp ~
    graceful-restart
    non-stop-routing
    router-id
    group ~                                         %logic=annet.rulebook.sitonica.bgp.undo_peer
    peer ~                                          %logic=annet.rulebook.sitonica.bgp.undo_peer
    address-family ~
        balance *                                   %logic=annet.rulebook.sitonica.undo.strange
        forwarding-conversational-learning
        import-route *
        network ~                                   %logic=annet.rulebook.sitonica.undo.two
        aggregate ~                                 %logic=annet.rulebook.sitonica.undo.two
        peer ~                                      %logic=annet.rulebook.sitonica.bgp.undo_peer
    ip vpn-instance *
        bmp ~
        graceful-restart
        non-stop-routing
        router-id
        group ~                                     %logic=annet.rulebook.sitonica.bgp.undo_peer
        peer ~                                      %logic=annet.rulebook.sitonica.bgp.undo_peer
