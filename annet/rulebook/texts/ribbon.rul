# Operators:
#   *  One argument in undo
#   ~  One or more arguments in undo
#
# Parameters:
#   %global         The command applies at any level below
#   %logic=...      Custom rule processing function
#   %diff_logic=... Custom diff building function.
#                   Works for sub-blocks, unlike %logic
#   %comment=...    Adds a comment after the row; shown with the patch --add-comments option
#                   Primarily used to generate special provisioning commands
# -----

system
    host-name

    time-zone

    tacplus-server
        * secret

    event-log
        files
        size

    ntp
        server ~

    services
        ssh
            root-login

    management-network
        network-bridge
            allow-6to4-tunnel-packets

    root-authentication
        encrypted-password

    login
        user *
            authentication
                user-encrypted-password
            class
            full-name

interfaces
    *
        description

chassis
    slot * *
        port *
            port-type
            otuc-options
                line-rate
            transceiver-options
                exp-transceiver-type
                tx-wavelength
            fiber-connectivity (internal|external) (uni-in|uni-out|bidirectional)
                peer-ne
                peer-slot
                peer-port
                fiber-length
                input-fiber-loss
                output-fiber-loss
            ots-options
                los-threshold
        oa-options (booster|preamp|amp)
            edfa-mode
            initial-gain
            exp-raman-gain
            max-number-channels
            output-pwr-per-channel
            tilt

~ %global
