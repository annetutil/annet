# Operators:
#   *  One argument in undo
#   ~  One or more arguments in undo
#
# Parameters:
#   %global         The command applies at any level below
#   %logic=...      Custom rule processing function
#   %diff_logic=... Custom diff building function.
#                   Works for sub-blocks, unlike %logic
#   %comment=...    Adds a comment after the row; shown with the patch --add-comments option
#                   Primarily used to generate special provisioning commands
# -----

ip domain-name *
hostname *

banner * %logic=annet.rulebook.cisco.misc.banner_any

ip community-list standard ~

!vrf context management
vrf context *

vlan group * vlan-list %logic=annet.rulebook.cisco.vlandb.simple
vlan */[^\d].*/
vlan %logic=annet.rulebook.cisco.vlandb.simple
    name

ip ssh version 2 %logic=annet.rulebook.cisco.misc.ssh_key

# ordering of SNMP blocks
ip access-list ~
snmp-server view ~
snmp-server community ~
snmp-server host ~
# Deleting a user using either SNMP or the CLI results in the user being deleted for both SNMP and the CLI.
# User-role mapping changes are synchronized in SNMP and the CLI.
!snmp-server user admin ~
!snmp-server user *
# Disabling this SNMP option throws WARNING which stops mpdaemon set-up process
no snmp-server sysobjectid type stack-oid

!interface */(mgmt|ipmi|Vlan1$)/

interface Loopback
    ipv6 address *
    ip address ~
    ! no ip address

# SVI/Subifs/Lagg
interface */(Vlan|Ethernet.*\.|port-channel.*\.?)\d+$/ %diff_logic=annet.rulebook.cisco.iface.diff
    vrf member
    ipv6 link-local
    ipv6 address *
    ipv6 nd ~                      %logic=annet.rulebook.cisco.misc.no_ipv6_nd_suppress_ra
    ip address ~
    ! no ip address
    mtu

# Physical
interface */\w*Ethernet[0-9\/]+$/     %logic=annet.rulebook.common.permanent %diff_logic=annet.rulebook.cisco.iface.diff
    switchport mode
    switchport trunk native vlan
    switchport access vlan
    switchport trunk allowed vlan %logic=annet.rulebook.cisco.vlandb.swtrunk
    vrf member
    ipv6 link-local
    ipv6 address *
    ip address ~
    ! no ip address
    channel-group
    mtu
    storm-control * level
    spanning-tree portfast

router bgp
    router-id
    vrf *
        router-id
        address-family ~
            maximum-paths
        neighbor ~
            update-source

policy-map type qos *
    class *            %ordered
        ~

prefix-set *
    ~              %rewrite %global

as-path-set *
    ~              %rewrite %global

community-set *
    ~              %rewrite %global

route-policy *
    ~              %rewrite %global

line ~
    exec-timeout
    transport input

description %global

no ~ %global
~ %global

# vim: set syntax=annrulebook:
