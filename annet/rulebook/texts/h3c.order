# vim: set syntax=annrulebook:
# This file defines the order in which the commands should be sent to the device.
# - If the order of a command does not matter - it can be left out of this file entirely.
# - If a command starts with undo and the %order_reverse parameter is set, the command is treated
#   as a reverse one, but takes its place among the direct ones where specified (i.e. undo vlan batch
#   will come after the interface blocks).

sysname

m-lag

# switch the BFD mode from software to hardware
undo hardware-resource firmware-mode *
hardware-resource firmware-mode *   %order_reverse

#clock
#info-center

# the vpn-instance OOB/MLAG is referenced from all over the place, so it is created as early as possible
ip vpn-instance */[OoMm][OoLl][BbAa].*/

#ntp
#dns

#mac-address timer aging

#rsa
#ecc

# since h3c does not allow two identical rules in a single prefix-list,
# all the non-matching ones have to be removed first and then filled in again
# in that case this line has to be uncommented, but it prevents the plist from being removed entirely
# first a stub rule is added to the ruleset so that it does not let the prefix-list "disappear"
# the index is referenced in the prefix-list patching logic in h3c.misc.prefix_list
*/(ip|ipv6)/ prefix-list * index 65535
undo */(ip|ipv6)/ prefix-list * index *   %order_reverse
*/(ip|ipv6)/ prefix-list
ip community-list

# common block for the fabric
bfd peer-ip
ip unreachables
ip ttl-expires
lldp global 
vxlan vlan-based
stp global
l2vpn enable
vxlan tunnel mac-learning
vxlan tunnel arp-learning
hardware-resource vxlan
vxlan ip-forwarding


line vty
    ~
ssh server 
netconf ssh server
sftp server
scp server

# next, if we have MLAG, vvtep has to be specified
evpn m-lag group 10.203.78.1

# next come the vsi tenants
vsi

ip vpn-instance
    route-distinguisher
    address-family evpn
        ~
    address-family ipv4
        ~
    address-family ipv6
        ~
    ~

# this must come after vpn-instance
ntp

#stp mode
#stp bpdu-protection
#stp enable
#stp region-configuration

acl port-pool
acl ip-pool
acl ipv6-pool
acl */(advanced|basic|mac|user-defined|name|number)/ ~
    undo rule * comment %order_reverse
    undo rule ~ %order_reverse
    undo description %order_reverse
    description
    rule * */deny|permit/
    rule * comment
acl ipv6 */(advanced|basic|name|number)/ ~
    undo rule * comment %order_reverse
    undo rule ~ %order_reverse
    undo description %order_reverse
    description
    rule * */deny|permit/
    rule * comment

system tcam

undo system tcam acl template * all %order_reverse
undo system tcam acl template * %order_reverse
undo system tcam acl$ %order_reverse

traffic classifier
traffic behavior
traffic policy
qos group
qos schedule-profile
port-wred

dhcp

vlan all
vlan 

hwtacacs-server
hwtacacs server
radius-server

local-user ~
    password hash *  %logic=annet.rulebook.h3c.aaa.user
    service-type ~   
    ~ %global

user-interface
drop-profile

interface */(?i)(M-GigabitEthernet[^.]*)[^.]\d*$/
FTP client
ftp client
sflow

# SR globally -> MPLS -> IS-IS -> IS-IS and SID on the interfaces
segment-routing
    sr-te policy *
        candidate-path * *
            undo segment-list * %order_reverse
    undo segment-list *  %order_reverse

# mpls is enabled globally first, and only then on the interfaces
mpls
    mpls te cspf
    mpls te cspf preferred-igp

mpls ldp
mpls ldp remote-peer *

explicit-path

vsi *
    mtu 
    vxlan
    evpn encapsulation vxlan
        route-distinguisher
        vpn-target

interface */Vsi\d+/
interface */Bridge-Aggregation\d+/
interface */LoopBack\d+/

interface *
    port link-mode * %order_reverse
    undo ip address * * sub  %order_reverse
    undo ip address * *  %order_reverse
    description
    ip binding
    ipv6 enable
    ipv6 nd ra prefix
    ipv6
    ip address * *
    ip address * * sub
    dhcpv6
    isis enable
    isis
    undo isis *
    undo isis enable  %order_reverse
    mpls
    mpls ldp
    mpls ldp transport-address interface
    mpls rsvp-te
    mpls rsvp-te bfd
    port link-type
    port trunk pvid
    port trunk permit
    undo port trunk permit vlan all
    undo port trunk permit vlan 1 %order_reverse
    port hybrid
    undo port hybrid vlan
    port hybrid tagged
    port hybrid untagged
    port hybrid vlan
    port hybrid pvid
    voice-vlan */\d+/
    voice-vlan
    undo port link-aggregation
    port link-aggregation
    mode
    qos (wfq|drr)
    qos queue
    vrrp6 vrid [11|12] virtual-ip FE80*
    vrrp6 vrid [11|12] virtual-ip
    vrrp6 vrid [11|12]
    vrrp vrid [11|12] virtual-ip
    vrrp vrid [11|12]
    ~
    poe

# The subifs of the ports must come after the configuration of the ports themselves; otherwise the switch complains that the port is l2
interface */\S+\.\d+/

# Some commands require the configuration to be defined on the L2 interfaces first, and only then on vlanif
interface */Vlan-interface\d+/

# Must come after interface because it references traffic-policy
# And exactly in this order
# policies reference behavior and classifier, and those reference acls
undo qos group          %order_reverse
undo qos schedule-profile	%order_reverse
undo traffic policy     %order_reverse
undo traffic behavior   %order_reverse
undo traffic classifier %order_reverse

# Must come after interface because it references the diffserv domain
undo diffserv domain * 	%order_reverse

# routes come after the interfaces
ip route-static
ipv6 route-static

route-policy

ospf
    opaque-capability enable
    area

bgp
    router-id
    graceful-restart
    timer keepalive
    # [NOCDEV-1182] load-balancing has several mutually exclusive flavours
    undo undo maximum load-balancing %order_reverse
    maximum load-balancing
    # [NOCDEV-2043] Only the peers and the groups are declared here
    # since they are referenced from the family blocks
    group
    # When the ASN changes, the old value is removed first and then the peer is created again.
    undo peer * as-number
    undo peer *
    peer * as-number *
    peer * local-as *
    peer * group *
    peer * connect-interface *
    address-family l2vpn evpn
        peer * enable
        peer * ~
    address-family ipv[46]
        balance
        pic
        additional-paths
        import-route
        group
        peer * as-number *
        peer * enable
        peer * ~
    # [NOCDEV-2043] Everything else in the global block is done here
    undo peer * description %order_reverse
    undo peer * * * %order_reverse
    undo peer * * %order_reverse
    undo group * %order_reverse
    peer * ~


# bfd is torn down after bgp, but before vpn
undo bfd * %order_reverse
undo bfd %order_reverse

undo ip vpn-instance %order_reverse
undo route-policy %order_reverse
undo route-policy */VRF_.*/ %order_reverse
undo ip community-list %order_reverse
undo ip community-filter %order_reverse
undo ip extcommunity-filter %order_reverse
undo ip as-path-filter %order_reverse

info-center

# Should be after acl definition
snmp-agent sys-info
snmp-agent mib-view
snmp-agent community complexity-check
snmp-agent community
snmp-agent target-host
snmp-agent trap source
snmp-agent
#ifindex constant

cpu-defend policy
cpu-defend-policy
slot *
    cpu-defend-policy %order_reverse
undo cpu-defend policy  %order_reverse

ssh server rsa-key min-length
rsa peer-public-key
ssh user
ssh user * assign
ssh user * authentication-type
ssh user * service-type

local-user * password
local-user * service-type
local-user * level
local-user * ftp-directory

stelnet server
stelnet ipv4 server
stelnet ipv6 server

telnet server acl
ssh server acl
*/(ftp|FTP)/ server acl
*/(ftp|FTP)/ acl
telnet ipv6 server acl
ssh ipv6 server acl
*/(ftp|FTP)/ ipv6 server acl
*/(ftp|FTP)/ ipv6 acl

ssh server-source all-interface
ssh ipv6 server-source all-interface
telnet server-source all-interface
telnet ipv6 server-source all-interface

#lldp

#stelnet
#ssh

#header

#command-privilege
#user-interface maximum-vty
#user-interface

domain
default-domain
telemetry
    sensor-group *
    destination-group *
    subscription *

diffserv domain *
    ip-dscp-inbound ~

#acls are removed at the very end
undo acl                %order_reverse

# ifaces are removed last of all
# subifs first
undo interface */.*[.]\d+/ %order_reverse
# vlanif
undo interface */Vlanif\d+/ %order_reverse
undo interface */Vbdif\d+/ %order_reverse

# an eth-trunk can only be removed after the member interfaces have been cleaned up
undo interface */Eth-Trunk\d+/  %order_reverse
undo interface             %order_reverse

# interface Tunnel* references 'explicit-path'
undo interface */Tunnel.*/ %order_reverse
undo explicit-path %order_reverse

# drop-profile can only be removed after the references to it on the interfaces are removed
undo drop-profile %order_reverse

# vlans are removed after vlanif/subif
undo vlan %order_reverse
undo vlan batch %order_reverse
undo observe-port %order_reverse

#sflow may be attached to a subif/eth-trunk
undo sflow %order_reverse

# This stub rule must be removed at the very end
# because if the prefix-list has to leave the configuration entirely
# all of its references in the config have to be removed before that
# the index is referenced in the prefix-list patching logic in h3c.misc.prefix_list
undo */(ip|ipv6)/ prefix-list * index 65535  %order_reverse

#remove template only after all references will be cleared
undo radius-server template %order_reverse
undo hwtacacs-server template %order_reverse

~
