# This file defines the order in which the commands should be sent to the device.
# - If the order of a command does not matter - it can be left out of this file entirely.
# - If a command starts with undo and the %order_reverse parameter is set, the command is treated
#   as a reverse one, but takes its place among the direct ones where specified.

# Features must be enabled first
feature %order_reverse
hostname
clock ~
logging
ntp enable
ntp server
# The commands and their order have to be listed below
no key %order_reverse
no username %order_reverse
no rsa %order_reverse
snmp-server enable
snmp-server view
snmp-server community
sflow
ip prefix-list
ipv6 prefix-list
route-map
ip vrf
ip domain-lookup
ip route
ipv6 route
interface *
    description
    ip vrf forwarding
    ipv6 address
    mtu
    lldp-agent
        set lldp
        lldp tlv
        dcbx
        exit
    sflow
ip community-list
router bgp *
    bgp ~
    neighbor * fall-over bfd
    neighbor * advertisement-interval *
    neighbor */[0-9a-fA-F\.\:]+/ peer-group %order_reverse
    neighbor */[0-9a-fA-F\.\:]+/ remote-as  %order_reverse
    neighbor */(\w+_?-?)+/ peer-group       %order_reverse
    neighbor */(\w+_?-?)+/ remote-as        %order_reverse
    neighbor * description *
    network *
    address-family ~
        max-paths ebgp *
        neighbor * fall-over bfd
        neighbor * advertisement-interval *
        neighbor */[0-9a-fA-F\.\:]+/ peer-group  %order_reverse
        neighbor */[0-9a-fA-F\.\:]+/ remote-as   %order_reverse
        neighbor */(\w+_?-?)+/ peer-group        %order_reverse
        neighbor */(\w+_?-?)+/ remote-as         %order_reverse
        neighbor * description *
        neighbor * activate
        network *
line
