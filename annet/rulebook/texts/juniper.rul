# Operators:
#   *  One argument in undo
#   ~  One or more arguments in undo
#
# Parameters:
#   %global         The command applies at any level below
#   %logic=...      Custom rule processing function
#   %diff_logic=... Custom diff building function.
#                   Works for sub-blocks, unlike %logic
#   %comment=...    Adds a comment after the row; shown with the patch --add-comments option
#                   Primarily used to generate special provisioning commands
# -----

system
    host-name *
    name-server
        ~
    ntp
        server *
        source-address *
    syslog
        host *
            match
        file messages
            match
            archive        %diff_logic=annet.rulebook.juniper.misc.syslog_archive_diff

routing-options
    autonomous-system *
    rib *
        */(aggregate|static)/
            route *                    %logic=annet.rulebook.common.undo_redo
                ~
    ~

services
    ~

chassis
    tfeb
        slot *
            inline-services
                flow-table-size
                    ipv4-flow-table-size
                    ipv6-flow-table-size
    fpc *
        inline-services
            flow-table-size
                ipv4-flow-table-size
                ipv6-flow-table-size
        pic *
            ~

protocols
    isis
        overload
        interface *
            level 2      %diff_logic=annet.rulebook.juniper.misc.level2_interface_diff
                ~
    mpls
        path *
            *           %ordered
    source-packet-routing
        segment-list *
            *           %ordered
                ~

routing-instances
    ~
        routing-options
            autonomous-system *
            rib *
                */(aggregate|static)/
                    route *            %logic=annet.rulebook.common.undo_redo
                        ~
        protocols
            bgp
                group *
                    local-as

interfaces
    *
        unit *
            description ~
            mtu *
            vlan-tags
            family inet6
                address * %diff_logic=annet.rulebook.juniper.iface.ipv6_addr
        description ~
        mtu *
        hold-time

snmp
    community *
        ~

ntp
    ~

class-of-service
    classifiers
        dscp *
            ~
            forwarding-class *
                ~
    forwarding-classes
        class *
        ~

    interfaces
        *
                    unit *
                        rewrite-rules
                            dscp *
                            dscp-ipv6 *
                            exp *
                            ieee-802.1 *
                            ~

policy-options
    community ~
    prefix-list ~
    policy-statement *
        term *               %ordered
            from             %logic=annet.rulebook.common.undo_redo
                ~
            then             %logic=annet.rulebook.common.undo_redo
                community ~  %ordered
                ~
            ~                %global
        ~                    %global


firewall
    family *
        filter *
            term *     %ordered
                from   %logic=annet.rulebook.common.undo_redo
                    ~
                then   %logic=annet.rulebook.common.undo_redo
                    ~
                ~      %global


forwarding-options
    ~


~ %global
