# Operators:
#   *  One argument in undo
#   ~  One or more arguments in undo
#
# Parameters:
#   %global         The command applies at any level below
#   %logic=...      Custom rule processing function
#   %diff_logic=... Custom diff building function.
#                   Works for sub-blocks, unlike %logic
#   %comment=...    Adds a comment after the row; shown with the patch --add-comments option
#                   Primarily used to generate special provisioning commands
# -----

%context=block:ap-env

name:~               %logic=annet.rulebook.aruba.ap_env.hostname

*/ipaddr|netmask|gatewayip|dnsip|domainname/:...  %logic=annet.rulebook.aruba.ap_env.mgmt

usb-port-disable:... %logic=annet.rulebook.aruba.ap_env.patch_flag
iap_master:...       %logic=annet.rulebook.aruba.ap_env.patch_flag
iap_conductor:...    %logic=annet.rulebook.aruba.ap_env.patch_flag

iap_zone:~  %logic=annet.rulebook.aruba.ap_env.iap_zone

dot11a_radio:disable %logic=annet.rulebook.aruba.ap_env.dot11_radio
dot11g_radio:disable %logic=annet.rulebook.aruba.ap_env.dot11_radio

installation_type:...  %logic=annet.rulebook.aruba.ap_env.installation_type

standalone_mode:... %logic=annet.rulebook.aruba.ap_env.swarm_mode

*/wifi0_arm_(channel|power_10x)/:...    %logic=annet.rulebook.aruba.ap_env.wifi_arm
*/wifi1_arm_(channel|power_10x)/:...    %logic=annet.rulebook.aruba.ap_env.wifi_arm

a_ant_gain_10x:...  %logic=annet.rulebook.aruba.ap_env.ant_gain
g_ant_gain_10x:...  %logic=annet.rulebook.aruba.ap_env.ant_gain

a_ant_pol:...  %logic=annet.rulebook.aruba.ap_env.ant_pol
g_ant_pol:...  %logic=annet.rulebook.aruba.ap_env.ant_pol

%context=block:conf-t
syslog-server

*/syslog-level/ ~/(emergency|alert|critical|error|warn|notice|info|debug)/ * %logic=annet.rulebook.aruba.misc.syslog_level
*/syslog-level/ ~/(emergency|alert|critical|error|warn|notice|info|debug)/ %logic=annet.rulebook.aruba.misc.syslog_level

arm
    wide-bands
    a-channels
    g-channels
    min-tx-power
    max-tx-power
    160mhz-support
    free-channel-index
    band-steering-mode
    backoff-time
    air-time-fairness-mode

rf dot11g-radio-profile
    max-distance
    max-tx-power
    min-tx-power
    free-channel-index
    interference-immunity

rf dot11a-radio-profile
    max-distance
    max-tx-power
    min-tx-power
    free-channel-index
    interference-immunity

ip dhcp pool$
    dhcp-relay$
    dhcp-server
    dns-cache$
    dns-server
    domain-name
    lease-time
    subnet
    subnet-mask

wlan access-rule ~
    rule ~          %ordered

wlan ssid-profile ~
    g-basic-rates
    a-basic-rates
    wpa-passphrase
    radius-reauth-interval
    dtim-period

wlan auth-server ~
    ip
    deadtime
    key

hash-mgmt-user
ntp-server
rf-band
name
virtual-controller-ip

virtual-controller-country

wlan tacacs-server tacacs
    key
    timeout

ble-configure %ignore_case

no ~ %global
~ %global

# vim: set syntax=annrulebook:
