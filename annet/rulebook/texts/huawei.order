# vim: set syntax=annrulebook:
# This file defines the order in which the commands should be sent to the device.
# - If the order of a command does not matter - it can be left out of this file entirely.
# - If a command starts with undo and the %order_reverse parameter is set, the command is treated
#   as a reverse one, but takes its place among the direct ones where specified (i.e. undo vlan batch
#   will come after the interface blocks).


# First the ports are split and the resources are allocated

license

# First the ports are split and the resources are allocated
port split mode
port split dimension
port split refresh
dfs-group
assign forward

# Switch the port into 200G mode
port mode 200GE

#clock
#sysname
#info-center

# the vpn-instance Meth is referenced from all over the place, so it is created as early as possible

undo dcn

# the vpn-instance Meth is referenced from all over the place, so it is created as early as possible
ip vpn-instance */[Mm][Ee][Tt]h.*/

#ntp
#dns

#mac-address aging-time

#rsa
#ecc

# since Huawei does not allow two identical rules in a single prefix-list,
# all the non-matching ones have to be removed first and then filled in again
# in that case this line has to be uncommented, but it prevents the plist from being removed entirely
# first a stub rule is added to the ruleset so that it does not let the prefix-list "disappear"
# the index is referenced in the prefix-list patching logic in huawei.misc.prefix_list

rsa local-key-pair create
#ecc

# since Huawei does not allow two identical rules in a single prefix-list,
# all the non-matching ones have to be removed first and then filled in again
# in that case this line has to be uncommented, but it prevents the plist from being removed entirely
# first a stub rule is added to the ruleset so that it does not let the prefix-list "disappear"
# the index is referenced in the prefix-list patching logic in huawei.misc.prefix_list
ip */(ip|ipv6)/-prefix * index 99999999
undo ip */(ip|ipv6)/-prefix * index *   %order_reverse
ip */(ip|ipv6)/-prefix

xpl as-path-list
xpl

ip as-path-filter
ip community-filter
ip extcommunity-filter

tunnel-policy

# evpn-overlay must be declared before ip vpn-instance
evpn-overlay *

route-policy */VRF_.*/
ip vpn-instance
    ipv4-family
        route-distinguisher
        ~
    ipv6-family
        route-distinguisher
        ~
    ~

# this must come after vpn-instance
ntp

#stp mode
#stp bpdu-protection
#stp enable
#stp region-configuration

stp region-configuration
    instance ~
    active region-configuration

erps ring
#stp mode
#stp bpdu-protection
#stp enable

acl port-pool
acl ip-pool
acl ipv6-pool

acl

system tcam acl$
acl ~
    undo rule * description %order_reverse
    undo rule ~ %order_reverse
    rule * */deny|permit/
    rule * description

system tcam

undo system tcam acl template * all %order_reverse

system tcam acl template *

system tcam acl template * all
undo system tcam acl template * %order_reverse
undo system tcam acl$ %order_reverse

traffic classifier
traffic behavior
traffic policy
qos group
qos schedule-profile
port-wred

dhcp

*/igmp.?snooping/ enable

*/igmp.?snooping/

vlan reserved
vlan batch
vlan
    */igmp.?snooping/ enable
    */igmp.?snooping/
    undo */igmp.?snooping/ enable %order_reverse
vlan pool

undo */igmp.?snooping/ enable %order_reverse

hwtacacs-server
hwtacacs server

radius-server template *
radius-server

aaa
    undo local-user policy security-enhance
    undo user-password complexity-check
    local-aaa-user user-name complexity-check disable

    undo user-group %order_reverse
    undo task-group %order_reverse

    local-user ~

    */(authentication|authorization|accounting)-scheme/ *

    # domain references scheme
    domain *

    task-group
    user-group

    #pin removal order to ensure that local-user will be deleted last
    domain default
        radius-server *
    undo local-user * ftp-directory %order_reverse
    undo local-user * privilege %order_reverse
    undo local-user * level %order_reverse
    undo local-user * %order_reverse
    ~

domain

undo radius-server template * %order_reverse

user-interface
drop-profile

# SR globally -> MPLS -> IS-IS -> IS-IS and SID on the interfaces

ipv6

# SR globally -> MPLS -> IS-IS -> IS-IS and SID on the interfaces
segment-routing
    sr-te policy *
        candidate-path * *
            undo segment-list * %order_reverse
    undo segment-list *  %order_reverse

# mpls is enabled globally first, and only then on the interfaces
mpls
    mpls te cspf
    mpls te cspf preferred-igp

mpls ldp
    mtu-signalling
    ipv4-family
mpls ldp remote-peer *

explicit-path

route-policy EXPORT_ISIS

# must come before the interfaces, otherwise 'isis enable 1' is impossible
isis

undo interface */Vlanif\d+/ %order_reverse
interface */(?i)meth[\d\/]+/
interface */Vlanif\d+/

FTP client
ftp client
sflow

bridge-domain *
    vxlan
    evpn
    undo evpn
    undo vxlan

# Must come before interface, since the interface level references the diffserv domain
diffserv domain *

lldp enable

# dot1x must be enabled before interface
# since additional per-interface dot1x settings are used there

dot1x enable

# lnp must be disabled before interface

lnp disable

# The existing Vbdifs are removed before the new ones are created

    ip-dscp-inbound ~

# an eth-trunk can only be removed after the member interfaces have been cleaned up
undo interface */Vbdif\d+/ %order_reverse
undo interface */.*[.]\d+/ %order_reverse

interface */Vbdif\d+/
interface */Eth-Trunk\d+/

bfd
interface */LoopBack\d+/
interface */Tunnel.*/
    tunnel-protocol
    mpls te signal-protocol segment-routing
    statistic enable
    mpls te path
    mpls te path metric-type

interface *
    # must come before undo portswitch, since afterwards it will not let it be removed
    undo mac-address learning     %order_reverse
    undo portswitch
    undo ip address * * sub  %order_reverse
    undo ip address * *  %order_reverse
    undo ip address unnumbered  %order_reverse
    undo ip binding vpn-instance * %order_reverse
    portswitch  %order_reverse
    undo dot1x max-user *
    undo dot1x guest-vlan *
    undo dot1x mac-bypass
    ip binding
    ipv6 enable
    ipv6 nd ra prefix
    ipv6
    ip address * *
    ip address * * sub
    dhcpv6
    isis enable
    isis ipv6 enable
    isis
    undo isis *
    undo isis enable  %order_reverse
    undo isis ipv6 enable  %order_reverse
    mpls
    mpls ldp
    mpls ldp transport-address interface
    mpls rsvp-te
    mpls rsvp-te bfd
    port link-type
    stp disable
    stp edged-port
    erps ring
    undo erps ring
    port trunk pvid
    port trunk allow-pass
    undo port trunk allow-pass vlan all
    undo port trunk allow-pass vlan 1 %order_reverse
    port hybrid
    undo port hybrid vlan
    port hybrid tagged
    port hybrid untagged
    port hybrid vlan
    port hybrid pvid
    voice-vlan */\d+/
    voice-vlan
    undo eth-trunk
    eth-trunk
    mode
    qos (wfq|drr)
    qos queue
    vrrp6 vrid [11|12] virtual-ip FE80*
    vrrp6 vrid [11|12] virtual-ip
    vrrp6 vrid [11|12]
    vrrp vrid [11|12] virtual-ip
    vrrp vrid [11|12]
    ~
    poe
# The subifs of the ports must come after the configuration of the ports themselves; otherwise the switch complains that the port is l2
interface */\S+\.\d+/

undo erps ring

# A port is added to a monitor-link group after the interfaces are created
# A port is removed from a monitor-link group before the interfaces are removed

monitor-link group *
    port * downlink *
    undo port * downlink * %order_reverse

# Must come after interface because it references the diffserv domain

undo diffserv domain * 	%order_reverse

# routes come after the interfaces
ip route-static
ipv6 route-static

route-policy
    apply ~
    if-match ~


ospf
    opaque-capability enable
    area

bgp
    router-id
    # [NOCDEV-1182] load-balancing has several mutually exclusive flavours
    undo undo maximum load-balancing %order_reverse
    maximum load-balancing
    # [NOCDEV-2043] Only the peers and the groups are declared here
    # since they are referenced from the family blocks
    undo group * listen external
    group
    peer * as-number *
    peer * fake-as * prepend-global-as
    peer * local-as *
    peer * group *
    vpn-instance ~
        group
        peer * as-number *
        peer * fake-as * prepend-global-as
        peer * group *
        peer * ~
    ipv[46]-family|link-state-family unicast|l2vpn-family evpn
        undo undo maximum load-balancing %order_reverse
        maximum load-balancing
        group
        peer * as-number *
        peer * fake-as * prepend-global-as
        peer * enable
        peer * ~
    l2vpn-ad-family
        peer * enable
        peer * ~
    # [NOCDEV-2043] Everything else in the global block is done here
    undo peer * description %order_reverse
    undo peer * group * %order_reverse
    undo peer * * * * %order_reverse
    undo peer * * * %order_reverse
    undo peer * * %order_reverse
    undo peer * %order_reverse
    undo group * %order_reverse
    peer * ~


# bfd is torn down after bgp, but before vpn
    peer * capability-advertise graceful-restart
    peer * graceful-restart timer restart


# bfd is torn down after bgp, but before vpn
undo bfd * %order_reverse
undo bfd %order_reverse

undo ip vpn-instance %order_reverse
undo route-policy %order_reverse
undo route-policy */VRF_.*/ %order_reverse
undo ip community-filter %order_reverse
undo ip extcommunity-filter %order_reverse
undo ip as-path-filter %order_reverse

info-center

# Should be after acl definition
snmp-agent sys-info
snmp-agent mib-view
snmp-agent community complexity-check
snmp-agent community
snmp-agent target-host
snmp-agent trap source
snmp-agent
#ifindex constant

cpu-defend policy
cpu-defend-policy
slot *
    cpu-defend-policy %order_reverse
undo cpu-defend policy  %order_reverse

ssh server rsa-key min-length
rsa peer-public-key
ssh user
ssh user * assign
ssh user * authentication-type
ssh user * service-type

local-user * password
local-user * service-type
local-user * level
local-user * ftp-directory

stelnet server
stelnet ipv4 server
stelnet ipv6 server

telnet server acl
ssh server acl
*/(ftp|FTP)/ server acl
*/(ftp|FTP)/ acl
telnet ipv6 server acl
ssh ipv6 server acl
*/(ftp|FTP)/ ipv6 server acl
*/(ftp|FTP)/ ipv6 acl

ssh server-source all-interface
ssh ipv6 server-source all-interface
telnet server-source all-interface
telnet ipv6 server-source all-interface

#lldp

#stelnet
#ssh

#header

#command-privilege
#user-interface maximum-vty
#user-interface

default-domain
telemetry
    sensor-group *
    destination-group *
    subscription *

# an eth-trunk can only be removed after the member interfaces have been cleaned up
undo interface */Eth-Trunk\d+/  %order_reverse
undo interface             %order_reverse

# interface Tunnel* references 'explicit-path'
undo interface */Tunnel.*/ %order_reverse
undo explicit-path %order_reverse

# drop-profile can only be removed after the references to it on the interfaces are removed
undo drop-profile %order_reverse

# vlans are removed after vlanif/subif
undo vlan %order_reverse
undo vlan batch %order_reverse
undo observe-port %order_reverse

# Must come after interface because it references traffic-policy
# And exactly in this order
# policies reference behavior and classifier, and those reference acls

undo bridge-domain %order_reverse

# l2 interfaces can only be added after the vlan has been removed

interface */\S+\.\d+/ mode l2

# Must come after interface because it references traffic-policy
# Must come after the interfaces are removed, otherwise we get the error:
# a policy that is applied on an interface cannot be removed
# And exactly in this order
# policies reference behavior and classifier, and those reference acls
undo qos group          %order_reverse
undo qos schedule-profile	%order_reverse
undo traffic policy     %order_reverse
undo traffic behavior   %order_reverse
undo traffic classifier %order_reverse

#acls are removed at the very end
undo acl                %order_reverse

#sflow may be attached to a subif/eth-trunk
undo sflow %order_reverse

# This stub rule must be removed at the very end
# because if the prefix-list has to leave the configuration entirely
# all of its references in the config have to be removed before that
# the index is referenced in the prefix-list patching logic in huawei.misc.prefix_list
undo ip */(ip|ipv6)/-prefix * index 99999999  %order_reverse

#remove template only after all references will be cleared
undo radius-server template %order_reverse
undo hwtacacs-server template %order_reverse

~
